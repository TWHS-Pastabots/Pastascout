# Copy this file to `.env` (same folder) and fill it in, then restart the server.
# `.env` is gitignored — the key stays on your machine.

# --- The Blue Alliance auto-sync (optional) -------------------------------
# Set these two and the app pulls the event automatically on startup and every
# few minutes. Nobody else on the team needs a TBA account or has to click
# "Import" — they just open the site and the schedule is already there.
#
# Get a free read-only key at https://www.thebluealliance.com/account
# (sign-in is via Google; a personal Gmail works if a school account is blocked).
TBA_API_KEY=
# The event to keep in sync, e.g. 2026caav — find it in the event's TBA URL.
TBA_EVENT_KEY=
# How often to re-pull the schedule and results, in minutes.
TBA_SYNC_INTERVAL_MINUTES=3

# --- Server -------------------------------------------------------------
PORT=5174
DB_PATH=./data/scouting.db

# --- Turso (optional, for a cloud deployment) -----------------------------
# Leave both blank to use the local SQLite file above (the laptop-at-a-
# competition setup — works fully offline, no internet needed at all).
#
# Set both to persist to a hosted Turso database instead. This is for the
# "host it in the cloud" scenario — e.g. the server running on a platform like
# Render whose free tier doesn't guarantee the local disk survives a restart.
# Create a free database at https://turso.tech (dashboard, no CLI needed) and
# copy the values from there.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Analyst password (optional) -----------------------------------------
# Leave blank and the Analyst section (dashboard, pick list, event setup) is
# open to anyone, same as before. Set it and every device has to enter this
# password once before it'll load — keeps opposing teams/randoms out of your
# rankings and pick list at a competition. It's one shared password, not
# individual accounts.
ANALYST_PASSWORD=
